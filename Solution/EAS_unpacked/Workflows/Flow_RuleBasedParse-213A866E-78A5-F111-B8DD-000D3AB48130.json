                  "IsMatch": "@if(equals(item()?['crb7a_matchtype'], 884000000), contains(toLower(coalesce(triggerBody()?['crb7a_senderemail'], '')), toLower(item()?['crb7a_patternvalue'])), if(equals(item()?['crb7a_matchtype'], 884000001), contains(toLower(coalesce(triggerBody()?['crb7a_emailsubject'], '')), toLower(item()?['crb7a_patternvalue'])), if(equals(item()?['crb7a_matchtype'], 884000002), contains(toLower(coalesce(triggerBody()?['crb7a_bodypreview'], '')), toLower(item()?['crb7a_patternvalue'])), false)))"
                }
              },
              "description": "TODO: Match Type Regex (884000003) is intentionally NOT implemented and falls through to false. Regex needs an Azure Function (Regex.IsMatch) called as a separate action once a real regex rule exists."
            },
            "Filter_array_-_Matched_Rules": {
              "runAfter": {
