                      "item/crb7a_processeddate": "@utcNow()",
                      "item/crb7a_runid": "@workflow()?['run']?['name']",
                      "item/crb7a_stagename": "RuleBasedParse",
                      "item/crb7a_status": 884000001
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {
                "Filter_array_-_Matched_Rules": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {
                  "Add_a_new_row_-_Log_No_Match": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "7bad45c9-4657-41a5-9d98-e9eb05d196ff"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "CreateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
