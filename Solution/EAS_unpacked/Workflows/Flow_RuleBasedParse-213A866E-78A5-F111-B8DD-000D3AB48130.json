                      "item/crb7a_stagename": "RuleBasedParse",
                      "item/crb7a_status": 884000001
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {},
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@actions('Scope_-_Catch')?['status']",
