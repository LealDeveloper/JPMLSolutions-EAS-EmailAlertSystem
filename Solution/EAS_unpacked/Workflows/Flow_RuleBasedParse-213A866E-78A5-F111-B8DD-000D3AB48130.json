                      "item/crb7a_EmailCategory@odata.bind": "@concat('/crb7a_dic_emailcategories(', outputs('Compose_-_First_Match')?['CategoryId'], ')')",
                      "item/crb7a_parsemethod": 884000000,
                      "item/crb7a_prioritynumber": "@outputs('Compose_-_First_Match')?['Priority']",
                      "item/crb7a_status": "Categorized"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                },
                "Add_a_new_row_-_Log_Match": {
                  "runAfter": {
                    "Update_a_row_-_Categorize_Email": [
