                  },
                  "metadata": {
                    "operationMetadataId": "36f303f0-0adb-4b7a-bc3f-b73b67cf94c6"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "crb7a_tbl_processinglogs",
                      "item/crb7a_EmailRecord@odata.bind": "@concat('/crb7a_tbl_emailrecords(', triggerBody()?['crb7a_tbl_emailrecordid'], ')')",
